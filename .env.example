# Base URL of the remotesea-api NestJS backend
VITE_API_URL=http://localhost:4000

# Optional: Sentry DSN for error tracking, performance monitoring, and session replay.
# Leave unset to disable (initMonitoring() no-ops). Never active outside production builds.
VITE_SENTRY_DSN=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable.
VITE_GA_MEASUREMENT_ID=

# Sprint testing board (/sprints). Always available in `vite dev`; set to "true" to expose it in a build.
VITE_ENABLE_SPRINT_BOARD=
# Which sprints the board shows: "1" (default), a list like "1,2", or "all" to restore every sprint.
VITE_VISIBLE_SPRINTS=
