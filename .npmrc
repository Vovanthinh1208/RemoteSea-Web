# Render sets NODE_ENV=production during the build step, which makes npm
# skip devDependencies by default (confirmed live: `npm install` under
# NODE_ENV=production silently removes vite, @types/node, and every other
# devDependency). This build needs them — `tsc -b && vite build` requires
# vite's own type definitions (tsconfig.app.json's "types": ["vite/client"])
# and @types/node (tsconfig.node.json's "types": ["node"], used by
# vite.config.ts) — so skipping devDependencies breaks the build with
# TS2688 "Cannot find type definition file" before it ever gets to running
# vite. This forces devDependencies to install regardless of NODE_ENV.
production=false
